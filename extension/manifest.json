{
  "manifest_version": 3,
  "name": "ClipSnatcher",
  "version": "1.4.1",
  "description": "Save videos from X, Reddit and Facebook posts. Keeps a local, searchable history. No tracking, no servers.",
  "key": "",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": [
    "activeTab",
    "downloads",
    "downloads.open",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "offscreen"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://pbs.twimg.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://*.redd.it/*",
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://web.facebook.com/*",
    "https://fb.watch/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipSnatcher",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      }
    },
    "save-video": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the video in the current tab"
    },
    "copy-last": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy the last saved video to the clipboard (macOS, needs the copy helper)"
    }
  }
}
