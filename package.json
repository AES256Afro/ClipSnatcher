{
  "name": "clipsnatcher",
  "version": "1.5.2",
  "private": true,
  "description": "Chrome extension that saves videos from X, Reddit and Facebook posts. The extension itself is in extension/ and needs no build step.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "bash scripts/build-store-zip.sh",
    "test:browser": "node browser-tests/run.mjs"
  },
  "engines": {
    "node": ">=20.3"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "typescript": "5.9.3"
  }
}
