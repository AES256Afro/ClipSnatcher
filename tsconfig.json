{
  // Type-checks the extension's plain JavaScript (npm run typecheck). Nothing is compiled:
  // Chrome still loads extension/ exactly as it is.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["extension/**/*.js"]
}
